{
  "opencollection": "1.0.0",
  "info": {
    "name": "Laka accounts deeplinks API",
    "version": "2024-09-01"
  },
  "items": [
    {
      "info": {
        "name": "deeplinks",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get All Deeplinks",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.uat.laka.co/v3/deeplinks",
            "headers": [
              {
                "name": "x-api-region",
                "value": ""
              },
              {
                "name": "x-api-language",
                "value": ""
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Get all of the deeplinks."
        },
        {
          "info": {
            "name": "Create Deeplink",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.uat.laka.co/v3/deeplinks",
            "headers": [
              {
                "name": "x-api-region",
                "value": ""
              },
              {
                "name": "x-api-language",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Create a new deeplink. Choose a resource to change the purpose of the deeplink."
        }
      ]
    }
  ],
  "bundled": true
}